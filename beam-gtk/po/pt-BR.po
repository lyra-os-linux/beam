msgstr "Abrir em tela cheia"

msgid "Connection"
msgstr "Conexão"

msgid "Authentication"
msgstr "Autenticação"

msgid "Display"
msgstr "Exibição"

msgid "Edit connection"
msgstr "Editar conexão"

msgid "Save"
msgstr "Salvar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Security"
msgstr "Segurança"

msgid "Trusted certificates"
msgstr "Certificados confiáveis"

msgid "Certificate fingerprints confirmed on previous connections (TOFU verification). Removing an entry requires confirmation again the next time you connect to that server."
msgstr "Impressões digitais de certificados confirmadas em conexões anteriores (verificação TOFU). Remover uma entrada exige nova confirmação na próxima conexão com esse servidor."

msgid "No trusted certificates yet"
msgstr "Nenhum certificado confiável ainda"

msgid "Remove trust"
msgstr "Remover confiança"

msgid "Password"
msgstr "Senha"

msgid "Save to keyring"
msgstr "Salvar no chaveiro"

msgid "Use the system Secret Service so you are not asked again"
msgstr "Usar o Serviço de Segredos do sistema para não perguntar novamente"

msgid "Authentication required"
msgstr "Autenticação necessária"

msgid "Enter the password for account “{username}” to continue."
msgstr "Digite a senha da conta “{username}” para continuar."

msgid "Verify server identity"
msgstr "Verificar identidade do servidor"

msgid "This is the first connection to <b>{address}</b>.\n\nCertificate fingerprint (SHA-256):\n<tt>{fingerprint}</tt>\n\nConfirm with the server administrator that this fingerprint is correct before continuing."
msgstr "Esta é a primeira conexão com <b>{address}</b>.\\n\\nImpressão digital do certificado (SHA-256):\\n<tt>{fingerprint}</tt>\\n\\nConfirme com o administrador do servidor que esta impressão digital está correta antes de continuar."

msgid "Trust and connect"
msgstr "Confiar e conectar"

msgid "⚠ Possible attack detected"
msgstr "⚠ Possível ataque detectado"

msgid "The certificate presented by <b>{address}</b> has changed since the last connection.\n\nPrevious fingerprint:\n<tt>{previous}</tt>\n\nCurrent fingerprint:\n<tt>{fingerprint}</tt>\n\nThis may indicate an attempt to intercept the connection (man-in-the-middle), or simply that the server certificate was renewed. Continue only if you are certain of the reason."
msgstr "O certificado apresentado por <b>{address}</b> mudou desde a última conexão.\\n\\nImpressão digital anterior:\\n<tt>{previous}</tt>\\n\\nImpressão digital atual:\\n<tt>{fingerprint}</tt>\\n\\nIsso pode indicar uma tentativa de interceptar a conexão (man-in-the-middle), ou apenas que o certificado do servidor foi renovado. Continue somente se tiver certeza do motivo."

msgid "Trust anyway"
msgstr "Confiar mesmo assim"

msgid "Fullscreen"
msgstr "Tela cheia"

msgid "Send Ctrl+Alt+Del"
msgstr "Enviar Ctrl+Alt+Del"

msgid "Disconnect"
msgstr "Desconectar"

msgid "Remote desktop"
msgstr "Área de trabalho remota"

msgid "Connection lost"
msgstr "Conexão perdida"

msgid "Reconnect"
msgstr "Reconectar"

msgid "Connection lost: {detail}"
msgstr "Conexão perdida: {detail}"

msgid "Connection failed: {detail}"
msgstr "Falha na conexão: {detail}"

msgid "Failed to send data"
msgstr "Falha ao enviar dados"

msgid "Server certificate rejected by the user"
msgstr "Certificado do servidor recusado pelo usuário"

msgid "Connection cancelled by the user"
msgstr "Conexão cancelada pelo usuário"

msgid "Network error: {detail}"
msgstr "Erro de rede: {detail}"

msgid "Close"
msgstr "Fechar"

msgid "Could not load trusted certificates"
msgstr "Não foi possível carregar os certificados confiáveis"

msgid "Could not save connections"
msgstr "Não foi possível salvar as conexões"

msgid "{feature} unavailable: {detail}"
msgstr "{feature} indisponível: {detail}"

msgid "Input queue full; disconnected to avoid losing key releases"
msgstr "Fila de entrada cheia; conexão encerrada para evitar perda de liberação de teclas"

msgid "Timed out sending data"
msgstr "Tempo limite excedido ao enviar dados"

msgid "Timed out reactivating the session"
msgstr "Tempo limite excedido ao reativar a sessão"

msgid "Session ended unexpectedly"
msgstr "A sessão terminou inesperadamente"
