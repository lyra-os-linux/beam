{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beam",
  "mainBinaryName": "beam",
  "identifier": "org.lyraos.Beam",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "enableGTKAppId": false,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Beam",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
